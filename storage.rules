rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Proof of pickup/delivery handover photos
    match /proofs/{routeId}/{filename} {
      // Must be authenticated, valid image MIME type, and max 5MB
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // Rider profile photos and signatures
    match /signatures/{riderId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.auth.uid == riderId
                    && request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
