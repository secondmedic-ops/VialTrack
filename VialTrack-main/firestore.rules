rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------------------
    // SECURITY OVERHAUL (Phase 2)
    //
    // The previous version of this file allowed `if true` on every collection -- anyone on the
    // internet, signed in or not, could read or write the entire database directly, with no app
    // or login involved at all. These rules replace that with real checks against the Firebase
    // Auth custom claims set by functions/index.js's migrateAccountsToFirebaseAuth /
    // provisionAccount (role: 'admin' | 'rider' | 'client', plus riderId / clientId).
    //
    // *** DO NOT PUBLISH THIS FILE UNTIL EVERY CURRENT RIDER AND CLIENT HAS BEEN THROUGH THE
    // "Migrate Accounts to Secure Login" step in Admin -> Alerts & Rules, with zero failures. ***
    // A rider/client with no real Firebase Auth account (request.auth == null for them) will be
    // locked out of every collection below the moment these rules go live -- there is no rule
    // clever enough to safely admit someone with no session at all. See the accompanying runbook
    // for the exact order of operations.
    // ---------------------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() ? request.auth.token.role : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    // Matches either the modern ('riderId') or legacy ('assignedRiderId') field name -- trip and
    // task documents have historically carried both, always set to the same value.
    function isAssignedRider(riderIdOnDoc) {
      return role() == 'rider' && isSignedIn() && request.auth.token.riderId == riderIdOnDoc;
    }

    function isThisRider(riderId) {
      return role() == 'rider' && isSignedIn() && request.auth.token.riderId == riderId;
    }

    function isAssignedClient(clientIdOnDoc) {
      return role() == 'client' && isSignedIn() && request.auth.token.clientId == clientIdOnDoc;
    }

    function isThisClient(clientId) {
      return role() == 'client' && isSignedIn() && request.auth.token.clientId == clientId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Trips collection: unified real-time sample collection lifecycle.
    // - Admin: full access.
    // - Rider: may read/update only a trip currently assigned to them. Never create (dispatch is
    //   admin-only) or delete.
    // - Client: read-only, only their own trip.
    match /trips/{tripId} {
      allow read: if isAdmin()
        || isAssignedRider(existing().riderId) || isAssignedRider(existing().assignedRiderId)
        || isAssignedClient(existing().clientId) || isAssignedClient(existing().clientLabId);
      allow create: if isAdmin();
      allow update: if isAdmin()
        || isAssignedRider(existing().riderId) || isAssignedRider(existing().assignedRiderId);
      allow delete: if isAdmin();
    }

    // Tasks collection: legacy/mirrored view of the same pickups -- identical access shape.
    match /tasks/{taskId} {
      allow read: if isAdmin()
        || isAssignedRider(existing().riderId) || isAssignedRider(existing().assignedRiderId)
        || isAssignedClient(existing().clientId) || isAssignedClient(existing().clientLabId);
      allow create: if isAdmin();
      allow update: if isAdmin()
        || isAssignedRider(existing().riderId) || isAssignedRider(existing().assignedRiderId);
      allow delete: if isAdmin();
    }

    // Attendance collection: rider check-in/out logs. Not currently written by the app, but kept
    // real (not `if true`) in case that changes -- a rider may only ever create/read their own
    // record; only admin can edit or delete after the fact.
    match /attendance/{attendanceId} {
      allow read: if isAdmin() || isAssignedRider(existing().riderId);
      allow create: if isAdmin() || isThisRider(incoming().riderId);
      allow update, delete: if isAdmin();
    }

    // Clients collection: diagnostic labs & hospitals. Admin manages everything; a client may
    // read (never write) their own profile. No self-service client write flow exists in the app
    // today -- if one is added later, extend this rule for the specific fields it needs.
    match /clients/{clientId} {
      allow read: if isAdmin() || isThisClient(clientId);
      allow write: if isAdmin();
    }

    // Riders collection: field pickup agents. Admin manages everything; a rider may read their
    // own profile and update it, EXCEPT for a short list of security-sensitive fields that must
    // only ever change through an admin action or the provisioning Cloud Function -- never
    // directly from the rider's own signed-in session. This is a deny-list (not an allow-list of
    // exact field names) deliberately, since the rider app writes many small operational fields
    // to its own document (heartbeats, check-in status, vehicle info, live location, push
    // tokens...) and a strict allow-list is one missed field name away from silently breaking
    // one of those flows in production.
    match /riders/{riderId} {
      allow read: if isAdmin() || isThisRider(riderId);
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isThisRider(riderId) &&
        !incoming().diff(existing()).affectedKeys().hasAny(
          ['password', 'authMigrated', 'authUid', 'assignedRouteIds', 'role']
        )
      );
      allow delete: if isAdmin();
    }

    // Routes collection: defined sample collection routes. Previously `allow read: if true`,
    // which meant anyone on the internet could read every hospital address, every OPD contact
    // person's name and mobile number, and (since the pickup-time feature) the full daily
    // collection schedule of the business. Those stop-level contacts ARE individual PII, so this
    // now requires a signed-in session. Only admin can create/edit/delete a route.
    match /routes/{routeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Locations collection: live GPS ping log (kept separate from the riderCoords field embedded
    // directly on trip documents). Not currently written by the app, but kept real in case that
    // changes -- a rider may only ever create a ping for themselves.
    match /locations/{locationId} {
      allow read: if isAdmin() || isAssignedRider(existing().riderId);
      allow create: if isAdmin() || isThisRider(incoming().riderId);
      allow update, delete: if isAdmin();
    }

    // Settings collection: global organisation config (e.g. the ops hotline number shown in the
    // rider app). Now signed-in only, for the same reason as `routes` above -- there is no case
    // where an anonymous visitor needs org configuration. Only admin can change it.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Harmless one-field connectivity check the app runs before anyone has signed in, to confirm
    // Firestore is reachable. No real data lives here, and it is the ONLY path that stays open to
    // an unauthenticated visitor -- deliberately, so a connectivity failure is distinguishable
    // from a permission failure on the login screen.
    match /test/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
