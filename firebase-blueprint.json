{
  "entities": {
    "Task": {
      "title": "PickupTask",
      "description": "A scheduled diagnostic sample pickup and delivery route task",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 20 },
        "timeSlot": { "type": "string", "maxLength": 20 },
        "routeId": { "type": "string", "maxLength": 128 },
        "routeName": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 128 },
        "riderId": { "type": "string", "maxLength": 128 },
        "riderName": { "type": "string", "maxLength": 128 },
        "riderPhone": { "type": "string", "maxLength": 32 },
        "riderVehicle": { "type": "string", "maxLength": 64 },
        "status": {
          "type": "string",
          "enum": ["upcoming", "started", "at_stop", "picked_up", "in_transit", "delivered", "delayed", "missed"]
        },
        "currentStopIndex": { "type": "number" },
        "stopsProgress": { "type": "array" },
        "destination": { "type": "object" },
        "isDelayed": { "type": "boolean" },
        "delayMinutes": { "type": "number" },
        "issueFlags": { "type": "array" },
        "createdAt": { "type": "string" },
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "date", "timeSlot", "routeId", "clientId", "riderId", "status"]
    },
    "Attendance": {
      "title": "AttendanceRecord",
      "description": "Daily attendance check-in and check-out logs for riders",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "riderId": { "type": "string", "maxLength": 128 },
        "riderName": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 20 },
        "checkInTime": { "type": "string", "maxLength": 64 },
        "checkInLocation": { "type": "object" },
        "checkOutTime": { "type": "string", "maxLength": 64 },
        "checkOutLocation": { "type": "object" },
        "totalHours": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["present", "on_duty", "completed", "leave", "absent"]
        },
        "leaveReason": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "riderId", "date", "checkInTime", "status"]
    },
    "Client": {
      "title": "Client",
      "description": "Diagnostic labs and hospital clients requesting sample logistics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "contactPerson": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 128 },
        "address": { "type": "string", "maxLength": 256 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "billingRatePerPickup": { "type": "number" }
      },
      "required": ["id", "name", "phone", "email", "active"]
    },
    "Rider": {
      "title": "PickupBoy",
      "description": "Field logistics pickup boys transporting samples in cold-boxes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 128 },
        "photoUrl": { "type": "string", "maxLength": 512 },
        "vehicleNumber": { "type": "string", "maxLength": 64 },
        "vehicleType": { "type": "string", "maxLength": 64 },
        "assignedRouteIds": { "type": "array" },
        "status": {
          "type": "string",
          "enum": ["active", "on_leave", "inactive"]
        },
        "joiningDate": { "type": "string", "maxLength": 64 },
        "currentLocation": { "type": "object" },
        "batteryLevel": { "type": "number" },
        "isOnline": { "type": "boolean" },
        "isCheckedIn": { "type": "boolean" },
        "lastPingTime": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "phone", "email", "status"]
    },
    "Route": {
      "title": "Route",
      "description": "Pre-configured sample pickup routes and time slots",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 500 },
        "destinationLab": { "type": "object" },
        "stops": { "type": "array" },
        "timeSlots": { "type": "array" },
        "active": { "type": "boolean" },
        "assignedRiderId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "clientId", "name", "active"]
    },
    "LocationPing": {
      "title": "LocationPing",
      "description": "Live GPS breadcrumb ping from rider device",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "riderId": { "type": "string", "maxLength": 128 },
        "riderName": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "speed": { "type": "number" },
        "heading": { "type": "number" },
        "battery": { "type": "number" },
        "taskId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "riderId", "timestamp", "lat", "lng"]
    },
    "Trip": {
      "title": "Trip",
      "description": "Unified real-time active sample collection trip between client, rider, and admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 128 },
        "clientCoords": { "type": "array" },
        "riderId": { "type": "string", "maxLength": 128 },
        "riderName": { "type": "string", "maxLength": 128 },
        "riderPhone": { "type": "string", "maxLength": 32 },
        "riderCoords": { "type": "array" },
        "stops": { "type": "array" },
        "currentStopIndex": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["assigned", "in_transit", "completed"]
        },
        "chillerTemp": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "clientId", "clientName", "riderId", "riderName", "status", "stops"]
    }
  },
  "firestore": {
    "/trips/{tripId}": {
      "schema": { "$ref": "#/entities/Trip" },
      "description": "Centralized active sample collection trips"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Collection of all pickup and delivery tasks"
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/Attendance" },
      "description": "Collection of daily rider attendance logs"
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Collection of client pathology labs and diagnostic centres"
    },
    "/riders/{riderId}": {
      "schema": { "$ref": "#/entities/Rider" },
      "description": "Collection of logistics field pickup personnel"
    },
    "/routes/{routeId}": {
      "schema": { "$ref": "#/entities/Route" },
      "description": "Collection of structured collection routes"
    },
    "/locations/{locationId}": {
      "schema": { "$ref": "#/entities/LocationPing" },
      "description": "Real-time location GPS pings from riders"
    }
  }
}
