rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' || 
        request.auth.token.email.matches('.*@secondmedic[.]com') ||
        request.auth.token.email.matches('.*admin.*')
      );
    }

    function isAssignedRider(riderId) {
      return isAuthenticated() && (request.auth.uid == riderId || request.auth.token.riderId == riderId);
    }

    // Riders Collection: Public read needed for terminal ID lookup; writes admin-only
    match /riders/{riderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Routes Collection: Admins full access; Riders only read/update their assigned routes
    match /routes/{routeId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.assignedRiderId == request.auth.uid ||
        resource.data.assignedRiderId == request.auth.token.riderId ||
        resource.data.riderId == request.auth.uid
      ));
      allow create: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && (
        resource.data.assignedRiderId == request.auth.uid ||
        resource.data.assignedRiderId == request.auth.token.riderId
      ));
      allow delete: if isAdmin();
    }

    // Clients & Labs: Admins full access; authenticated users read-only
    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Live GPS Telemetry: Only the active rider can write their own coordinates; Admins can read all
    match /telemetry/{riderId} {
      allow read: if isAuthenticated();
      allow write: if isAssignedRider(riderId) || isAdmin();
    }

    // Attendance & Check-ins
    match /attendance/{recordId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Audit logs & System alerts: Admin only
    match /alerts/{alertId} {
      allow read, write: if isAdmin();
    }
  }
}
